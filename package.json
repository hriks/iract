{
  "name": "iract",
  "version": "0.0.2",
  "description": "A lightweight React-like framework with hooks, context, and virtual DOM",
  "author": "hriks",
  "license": "MIT",
  "type": "module",
  "main": "./dist/iract.cjs",
  "module": "./dist/iract.esm.js",
  "browser": "./dist/iract.umd.js",
  "types": "./dist/iract.d.ts",
  "exports": {
    ".": {
      "import": "./dist/iract.esm.js",
      "require": "./dist/iract.cjs",
      "types": "./dist/iract.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs",
      "types": "./dist/vite.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "jsdom": "^24.0.0",
    "rollup": "^4.9.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "react",
    "virtual-dom",
    "hooks",
    "frontend",
    "ui",
    "framework",
    "lightweight",
    "vite",
    "jsx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hriks/iract.git"
  },
  "bugs": {
    "url": "https://github.com/hriks/iract/issues"
  },
  "homepage": "https://github.com/hriks/iract#readme"
}
